# Template environment file for local development
# Copy this file to `.env`: cp .env.example .env

PROJECT_NAME="register-id"
ENVIRONMENT="dev"
BUILD_VERSION="0.1.0-dev"

# ------------------------------------------------------------------------------
# Docker Compose & Reverse Proxy Configuration
# ------------------------------------------------------------------------------
# Options for COMPOSE_FILE:
# 1. Base stack (App + Redis):
#    COMPOSE_FILE=docker-compose.yml
# 2. Local MOSIP Development (App + Redis + PostgreSQL IDRepo + Keycloak IAM):
#    COMPOSE_FILE=docker-compose.yml:docker-compose.mosip.yml
# 3. Deployed behind Traefik gateway:
#    COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# 4. Deployed behind Traefik with local MOSIP containers:
#    COMPOSE_FILE=docker-compose.yml:docker-compose.mosip.yml:docker-compose.traefik.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.mosip.yml

# Public hostname. The Sandbox Kit only routes one label under the environment
# domain, so this is register.<domain> (register.ait.ac.th), not register.id.<domain>.
APP_HOSTNAME_DOMAIN=register.ait.ac.th

SOME_API_KEY="sk-xxxxxxxxxx"

LOG_DIR="logs/"
LOG_NAME="main.log"
LOG_ROTATE_NAME="main_rotate.log"
LOG_LEVEL="DEBUG"

FASTAPI_HOST="0.0.0.0"
FASTAPI_PORT=8000
FASTAPI_WORKERS=1

REDIS_PORT=6379
REDIS_PASSWORD="redispassword"
REDIS_URL="redis://:redispassword@localhost:6379/0"
# Fernet key for draft applications stored in Redis. python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APPLICATION_STORE_KEY="mkEO32N4m6jh9fr5a3NNd4MDgrQ-mJaFSdVnieadso4="

# Django settings overrides
DJANGO_SECRET_KEY="django-insecure-dev-key-change-in-production"
ALLOWED_HOSTS="*"
DEBUG="True"

# ------------------------------------------------------------------------------
# MOSIP Substrate: IDRepo Service, PostgreSQL & Keycloak IAM
# ------------------------------------------------------------------------------
MOSIP_IDREPO_PORT=8081
MOSIP_IDREPO_BASE_URL="http://localhost:8081"
# Local mock IDRepo serves the UIN generator on MOSIP_IDREPO_PORT.
# A Sandbox Kit deploy uses http://idgenerator.kernel.
MOSIP_IDGENERATOR_BASE_URL="http://localhost:8081"
# true keeps the in-process mock when the remote call fails. Unset or false is the shipped image.
IDREPO_INPROCESS_FALLBACK=true
# Per-ticket successful writes per hour. The Helm chart sets 100.
ENROLL_SUCCESS_LIMIT=30
MOSIP_HTTP_TIMEOUT=10
MOSIP_HTTP_RETRIES=2
MOSIP_HTTP_BACKOFF_SECONDS=0.2

POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="MosipPostgresPass123!"
POSTGRES_DB="postgres"

KEYCLOAK_URL="http://localhost:8080/auth"
# Browser redirects. In the Kit this is https://iam.<domain>/auth.
KEYCLOAK_PUBLIC_URL="http://localhost:8080/auth"
# Server-side token and admin calls. In the Kit this is the in-cluster service.
KEYCLOAK_INTERNAL_URL="http://localhost:8080/auth"
KEYCLOAK_PORT=8080
KEYCLOAK_REALM="mosip"
# IDRepo service token. client_credentials on KEYCLOAK_INTERNAL_URL / KEYCLOAK_REALM.
# Sent as Cookie: Authorization. No default for the id or the secret.
IDREPO_CLIENT_ID=
IDREPO_CLIENT_SECRET=
# Confidential client for the Keycloak admin API. client_credentials only.
# Realm-management roles: manage-users and view-users. Generate the secret per deployment.
KEYCLOAK_ADMIN_CLIENT_ID="register-id-admin"
KEYCLOAK_ADMIN_CLIENT_SECRET="local-dev-admin-secret"

# Citizen sign-in (authorization code + PKCE against KEYCLOAK_URL / KEYCLOAK_REALM).
# The gateway does not mint an access token. Leave the client secret empty for a public PKCE client.
KEYCLOAK_OIDC_CLIENT_ID="register-id"
KEYCLOAK_OIDC_CLIENT_SECRET=""
KEYCLOAK_OIDC_REDIRECT_URI="http://localhost:8000/api/login/callback"
# HttpOnly session cookie Secure flag. Unset follows ENVIRONMENT (off when ENVIRONMENT=dev).
REGISTER_ID_COOKIE_SECURE="false"

# Operator routes (list, read, audit). An empty token denies them.
# Role is reader or custodian. Custodian can also correct demographics, disable login, and delete a face.
REGISTER_ID_OPERATOR_TOKEN=""
REGISTER_ID_OPERATOR_ROLE="reader"

# SMTP enrollment confirmation (sends the UIN after POST /api/enroll).
# Leave both EMAIL_PROVIDER and SMTP_HOST empty to skip sending. A mail failure does not fail enrolment.
# SMTP_HOST is a generic server. EMAIL_PROVIDER=gmail remains a shortcut for smtp.gmail.com:587.
# SMTP_USER and SMTP_PASSWORD are optional. SMTP_STARTTLS defaults to true; set 0, false, no, or off to skip.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_PASSWORD=

