# Template environment file for local development
# Copy this file to `.env`: cp .env.example .env

PROJECT_NAME="register-id"
ENVIRONMENT="dev"
BUILD_VERSION="0.1.0-dev"

# ------------------------------------------------------------------------------
# Docker Compose & Reverse Proxy Configuration
# ------------------------------------------------------------------------------
# Options for COMPOSE_FILE:
# 1. Base stack (App + Redis):
#    COMPOSE_FILE=docker-compose.yml
# 2. Local MOSIP Development (App + Redis + PostgreSQL IDRepo + Keycloak IAM):
#    COMPOSE_FILE=docker-compose.yml:docker-compose.mosip.yml
# 3. Deployed behind Traefik gateway:
#    COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# 4. Deployed behind Traefik with local MOSIP containers:
#    COMPOSE_FILE=docker-compose.yml:docker-compose.mosip.yml:docker-compose.traefik.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.mosip.yml

# Ingress domain for Traefik (required when docker-compose.traefik.yml is enabled):
APP_HOSTNAME_DOMAIN=register.id.ait.ac.th

SOME_API_KEY="sk-xxxxxxxxxx"

LOG_DIR="logs/"
LOG_NAME="main.log"
LOG_ROTATE_NAME="main_rotate.log"
LOG_LEVEL="DEBUG"

FASTAPI_HOST="0.0.0.0"
FASTAPI_PORT=8000
FASTAPI_WORKERS=1

REDIS_PORT=6379
REDIS_PASSWORD="redispassword"
REDIS_URL="redis://:redispassword@localhost:6379/0"

# Django settings overrides
DJANGO_SECRET_KEY="django-insecure-dev-key-change-in-production"
ALLOWED_HOSTS="*"
DEBUG="True"

# ------------------------------------------------------------------------------
# MOSIP Substrate: IDRepo Service, PostgreSQL & Keycloak IAM
# ------------------------------------------------------------------------------
MOSIP_IDREPO_PORT=8081
MOSIP_IDREPO_BASE_URL="http://localhost:8081"

POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="MosipPostgresPass123!"
POSTGRES_DB="postgres"

KEYCLOAK_URL="http://localhost:8080/auth"
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER="admin"
KEYCLOAK_ADMIN_PASSWORD="admin"
KEYCLOAK_REALM="mosip"

# Citizen sign-in (authorization code + PKCE against KEYCLOAK_URL / KEYCLOAK_REALM).
# The gateway does not mint an access token. Leave the client secret empty for a public PKCE client.
KEYCLOAK_OIDC_CLIENT_ID="register-id"
KEYCLOAK_OIDC_CLIENT_SECRET=""
KEYCLOAK_OIDC_REDIRECT_URI="http://localhost:8000/api/login/callback"
# HttpOnly session cookie Secure flag. Unset follows ENVIRONMENT (off when ENVIRONMENT=dev).
REGISTER_ID_COOKIE_SECURE="false"

# Operator routes (list, read, audit). An empty token denies them.
# Role is reader or custodian. Custodian can also correct demographics, disable login, and delete a face.
REGISTER_ID_OPERATOR_TOKEN=""
REGISTER_ID_OPERATOR_ROLE="reader"

# SMTP enrollment confirmation (sends the UIN after POST /api/enroll).
# Leave EMAIL_PROVIDER empty to skip sending. Supported: gmail (smtp.gmail.com:587 STARTTLS).
# For Gmail, EMAIL_PASSWORD must be an app password, not the account password.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_PASSWORD=

