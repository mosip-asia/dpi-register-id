# Template environment file for local development
# Copy this file to `.env`: cp .env.example .env

PROJECT_NAME="register-id"
ENVIRONMENT="dev"
BUILD_VERSION="0.1.0-dev"

# ------------------------------------------------------------------------------
# Docker Compose & Reverse Proxy Configuration
# ------------------------------------------------------------------------------
# Options for COMPOSE_FILE:
# 1. Base stack (App + Redis):
#    COMPOSE_FILE=docker-compose.yml
# 2. Local MOSIP Development (App + Redis + PostgreSQL IDRepo + Keycloak IAM):
#    COMPOSE_FILE=docker-compose.yml:docker-compose.mosip.yml
# 3. Deployed behind Traefik gateway:
#    COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# 4. Deployed behind Traefik with local MOSIP containers:
#    COMPOSE_FILE=docker-compose.yml:docker-compose.mosip.yml:docker-compose.traefik.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.mosip.yml

# Ingress domain for Traefik (required when docker-compose.traefik.yml is enabled):
APP_HOSTNAME_DOMAIN=register.id.ait.ac.th

SOME_API_KEY="sk-xxxxxxxxxx"

LOG_DIR="logs/"
LOG_NAME="main.log"
LOG_ROTATE_NAME="main_rotate.log"
LOG_LEVEL="DEBUG"

FASTAPI_HOST="0.0.0.0"
FASTAPI_PORT=8000
FASTAPI_WORKERS=1

REDIS_PORT=6379
REDIS_PASSWORD="redispassword"
REDIS_URL="redis://:redispassword@localhost:6379/0"

# Django settings overrides
DJANGO_SECRET_KEY="django-insecure-dev-key-change-in-production"
ALLOWED_HOSTS="*"
DEBUG="True"

# ------------------------------------------------------------------------------
# MOSIP Substrate: PostgreSQL (IDRepo) & Keycloak IAM
# ------------------------------------------------------------------------------
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="MosipPostgresPass123!"
POSTGRES_DB="postgres"

KEYCLOAK_URL="http://localhost:8080/auth"
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER="admin"
KEYCLOAK_ADMIN_PASSWORD="admin"
KEYCLOAK_REALM="mosip"
